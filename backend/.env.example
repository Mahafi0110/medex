# ---------------------------------------------------------------------------
# MedEX backend - environment variables
#
# Local development: copy this file to `.env` inside backend/ and adjust.
# Render: paste the same keys into your backend service's Environment tab.
#
# NEVER commit a real .env, and never put real credentials in this file - it is
# tracked by git and this repository is public.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Leave this empty on Render: it defaults to False there, and True locally.
DEBUG=
# Only needed for custom domains - the *.onrender.com hostname is trusted
# automatically via RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Local dev: keep USE_POSTGRES=False (SQLite file at backend/db.sqlite3).
# Deployed:  set USE_POSTGRES=True and copy the five values from your Render
#            Postgres page ("Internal Database URL" components).
#            DB_HOST is the HOSTNAME ONLY - no database name, no scheme, no port.
#            On Render, SQLite is wiped on every deploy/restart: never use it there.
USE_POSTGRES=False
DB_NAME=medex
DB_USER=medex
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# --- Frontend / CORS / CSRF -------------------------------------------------
# The deployed frontend's origin. Adding it here automatically adds it to
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Django Admin login (used by `manage.py create_admin`) -------------------
# Render's Free instances have no Shell, so this is how the first admin login is
# created. The password is only set when the user is first created; use
# DJANGO_SUPERUSER_FORCE_RESET=True for one deploy to overwrite it later.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Uploaded images (Django Admin "media") ---------------------------------
# Default: stored under backend/media on the service's local disk, which Render
# wipes on every deploy/restart. Content committed to the repo survives.
#
# Option A - Render Persistent Disk (paid instances only): attach a disk and
#            point this at it, e.g. /var/data/media
MEDIA_ROOT_PATH=
# Serve /media/... through Django. Set False only if a CDN/S3 serves it.
SERVE_MEDIA=True
#
# Option B - S3-compatible object storage (Cloudflare R2 has a free tier):
#            uncomment `django-storages[s3]` in requirements.txt, then set
#            USE_S3=True and fill in the AWS_* values below.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# --- Email (Contact-form / Career-form notifications) -----------------------
# This block and backend/.env are the mail configuration: this file is the
# template, `.env` is the real (git-ignored) local copy, and the deployed
# service reads the same keys from its Render Environment tab (see render.yaml).
# Leave EMAIL_HOST empty to keep Django's console backend: each submission is
# printed into the server log instead of being sent, so nothing is lost while no
# mailbox is configured yet. SMTP also stays off while EMAIL_HOST_PASSWORD is
# empty, so a half-filled .env never turns every submission into a login error.
# medexbiomed.com mail is hosted on Google Workspace (MX -> Google), so:
#   Google Workspace         : smtp.gmail.com,     port 587, TLS on
#                              password = 16-char App Password, NOT the account
#                              password (needs 2-Step Verification on the user)
#   Microsoft 365            : smtp.office365.com, port 587, TLS on
# IMPORTANT on Render: Free web services cannot reach SMTP ports 25/465/587, so
# mail only leaves a paid instance (or the office server).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=MedEX Website <info@medexbiomed.com>
EMAIL_TIMEOUT=15

# Addresses that receive enquiry notifications (comma-separated) - the site
# owner. Falls back to Site Settings -> email when empty. Visitors are never
# emailed; replying to the notification does that (Reply-To: <visitor>).
CONTACT_NOTIFY_EMAILS=info@medexbiomed.com

# --- Public form protection --------------------------------------------------
# Per-IP limit for the Contact / Career forms (DRF throttle syntax).
CONTACT_THROTTLE_RATE=10/hour
# Number of proxy hops in front of the app, so the limit uses the real visitor
# IP from X-Forwarded-For (1 on Render).
NUM_PROXIES=1

# --- Build-time switches used by backend/build.sh ---------------------------
# SEED_DEMO_DATA=True          -> load the sample products/services content once
#                                 (only on an empty database; never overwrites).
# RESET_CONTENT=True           -> delete ALL existing site content first (your
#                                 admin login and contact messages are kept) so
#                                 the snapshot below loads with no leftover rows.
#                                 For ONE deploy, then remove.
# FORCE_CONTENT_LOAD=True      -> re-load core/fixtures/site_content.json over
#                                 the live content for ONE deploy, then remove.

