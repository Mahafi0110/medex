# Base URL for the Django REST API.
#
# LOCAL DEVELOPMENT: leave this commented out. Vite then proxies /api/* to
# http://127.0.0.1:8000 (see vite.config.ts) and the dev site talks to your
# local backend instead of the deployed one.
#
# DEPLOYED (Render static site): set this to your backend's API root in the
# service's Environment tab. Vite inlines VITE_* variables at BUILD time, so the
# change only takes effect after a rebuild/redeploy.
# VITE_API_BASE_URL=https://medex-backend-spat.onrender.com/api/v1