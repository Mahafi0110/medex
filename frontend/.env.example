# Base URL for the Django REST API.
# In local dev, leave this unset — Vite proxies /api to http://127.0.0.1:8000 (see vite.config.ts).
# In production, point it at your deployed backend, e.g.:
# VITE_API_BASE_URL=https://api.medex.health/api/v1
VITE_API_BASE_URL=https://medex-backend-spat.onrender.com/api/v1